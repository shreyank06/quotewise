# Postgres connection string (Neon/Supabase pooled URL works)
DATABASE_URL=postgres://user:password@host:5432/db
# 32 random bytes, base64. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Password given to every seeded login
SEED_PASSWORD=
# Optional: pre-load an Anthropic key into both seeded companies (local testing only)
SEED_ANTHROPIC_API_KEY=
